{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kakwok.github.io/schemas/talks.schema.json",
  "title": "Selected talks",
  "description": "Same `domain` axis as publications.yml, plus `kind`. Hand-curated.",
  "type": "array",
  "items": { "$ref": "#/$defs/talk" },

  "$defs": {
    "talk": {
      "type": "object",
      "required": ["date", "title", "event", "domain", "kind", "tags"],
      "additionalProperties": false,
      "properties": {
        "date": {
          "description": "YYYY-MM. Sorts the rendered output.",
          "type": "string",
          "pattern": "^[12][0-9]{3}-(0[1-9]|1[0-2])$"
        },
        "title": { "type": "string", "minLength": 5 },
        "event": {
          "description": "Conference or seminar series, e.g. 'ICHEP 2024'.",
          "type": "string",
          "minLength": 3
        },
        "location": { "type": ["string", "null"] },
        "url": {
          "description": "Indico / agenda link.",
          "type": ["string", "null"],
          "format": "uri",
          "pattern": "^https?://"
        },
        "domain": { "enum": ["physics", "computing"] },
        "kind": {
          "description": "Posters are recorded as `poster`; do not fold them into `parallel`.",
          "enum": ["plenary", "parallel", "poster", "seminar", "lecture"]
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/tag" }
        }
      }
    },

    "tag": {
      "enum": [
        "hep", "computing", "ml", "llp", "hnl", "trigger", "detector",
        "instrumentation", "gpu", "portability", "leadership", "outreach", "carve"
      ]
    }
  }
}
